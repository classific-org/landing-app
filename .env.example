# Required for production builds and SEO generation. Must be an absolute https origin.
SITE_ORIGIN=https://www.classific.example

# Optional. Absolute URL of the enquiry endpoint. Leave empty to keep submissions unavailable.
CONTACT_ENDPOINT=

# Optional. Base URL of the Classific API (no trailing slash). When set, builds read published
# blogs and projects from it. When empty, the bundled content is used.
CMS_API_URL=
